<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".ui.priority.PriorityResultFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/priority_toolbar"
        style="@style/Widget.Taski.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/priority_result_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/priority_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/priority_loading"
                android:indeterminate="true"
                app:indicatorColor="@color/primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/priority_not_found"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding"
            android:visibility="gone">

            <TextView
                style="@style/TextAppearance.Taski.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/priority_not_found_title" />

            <TextView
                style="@style/TextAppearance.Taski.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:text="@string/priority_not_found_body" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/priority_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/spacing_lg">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Taski.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_task_title"
                            style="@style/TextAppearance.Taski.ScreenTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="3"
                            tools:text="Finish SE4041 lab report" />

                        <FrameLayout
                            android:id="@+id/score_circle"
                            android:layout_width="@dimen/score_circle_size"
                            android:layout_height="@dimen/score_circle_size"
                            android:layout_marginTop="@dimen/spacing_lg"
                            android:background="@drawable/bg_score_circle">

                            <TextView
                                android:id="@+id/text_score"
                                style="@style/TextAppearance.Taski.Display"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="@color/primary"
                                tools:text="86" />
                        </FrameLayout>

                        <TextView
                            style="@style/TextAppearance.Taski.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:text="@string/priority_score_label" />

                        <TextView
                            android:id="@+id/text_score_caption"
                            style="@style/TextAppearance.Taski.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="86 / 100" />

                        <TextView
                            android:id="@+id/text_priority_level"
                            style="@style/TextAppearance.Taski.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:background="@drawable/bg_priority_chip"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingTop="@dimen/spacing_sm"
                            android:paddingEnd="@dimen/spacing_lg"
                            android:paddingBottom="@dimen/spacing_sm"
                            tools:text="High"
                            tools:textColor="@color/priority_high" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Taski.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Taski.Subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/priority_factors_title" />

                            <TextView
                                android:id="@+id/label_urgency"
                                style="@style/TextAppearance.Taski.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_lg"
                                android:textColor="@color/text_primary"
                                tools:text="Urgency · 40%" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/bar_urgency"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                app:indicatorColor="@color/primary"
                                app:trackColor="@color/outline"
                                app:trackCornerRadius="@dimen/progress_track_radius" />

                            <TextView
                                android:id="@+id/value_urgency"
                                style="@style/TextAppearance.Taski.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                tools:text="95 / 100" />

                            <TextView
                                android:id="@+id/label_importance_factor"
                                style="@style/TextAppearance.Taski.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_lg"
                                android:textColor="@color/text_primary"
                                tools:text="Importance · 40%" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/bar_importance"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                app:indicatorColor="@color/primary"
                                app:trackColor="@color/outline"
                                app:trackCornerRadius="@dimen/progress_track_radius" />

                            <TextView
                                android:id="@+id/value_importance"
                                style="@style/TextAppearance.Taski.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                tools:text="100 / 100" />

                            <TextView
                                android:id="@+id/label_effort_factor"
                                style="@style/TextAppearance.Taski.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_lg"
                                android:textColor="@color/text_primary"
                                tools:text="Effort · 20%" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/bar_effort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                app:indicatorColor="@color/accent"
                                app:trackColor="@color/outline"
                                app:trackCornerRadius="@dimen/progress_track_radius" />

                            <TextView
                                android:id="@+id/value_effort"
                                style="@style/TextAppearance.Taski.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                tools:text="88 / 100" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Taski.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Taski.Subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/priority_task_details" />

                            <TextView
                                android:id="@+id/text_deadline"
                                style="@style/TextAppearance.Taski.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                tools:text="Deadline: 12 Sep 2026" />

                            <TextView
                                android:id="@+id/text_importance"
                                style="@style/TextAppearance.Taski.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                tools:text="Importance: High" />

                            <TextView
                                android:id="@+id/text_effort"
                                style="@style/TextAppearance.Taski.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                tools:text="Estimated effort: 2h" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Taski.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Taski.Subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/priority_reasons_title" />

                            <LinearLayout
                                android:id="@+id/container_reasons"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Taski.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Taski.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/details_ai_brand"
                                android:textColor="@color/primary"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/TextAppearance.Taski.Subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/priority_why_title" />

                            <TextView
                                android:id="@+id/text_ai_why"
                                style="@style/TextAppearance.Taski.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                tools:text="This task is highly prioritized because its deadline is approaching." />

                            <TextView
                                style="@style/TextAppearance.Taski.Subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_lg"
                                android:text="@string/priority_recommendation_title" />

                            <TextView
                                android:id="@+id/text_ai_recommendation_title"
                                style="@style/TextAppearance.Taski.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_lg"
                                android:textColor="@color/primary"
                                android:textStyle="bold"
                                tools:text="Start this task today." />

                            <TextView
                                android:id="@+id/text_ai_recommendation_body"
                                style="@style/TextAppearance.Taski.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                tools:text="Its deadline and importance make it a higher priority than your other pending tasks." />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_continue"
        style="@style/Widget.Taski.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_margin="@dimen/screen_padding"
        android:minHeight="@dimen/button_height"
        android:text="@string/priority_continue" />

</LinearLayout>
