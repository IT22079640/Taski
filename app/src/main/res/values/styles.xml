<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Taski" parent="android:Widget" />

    <style name="Widget.Taski.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
        <item name="strokeColor">@color/outline</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <style name="Widget.Taski.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
    </style>

    <style name="Widget.Taski.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
    </style>

    <style name="Widget.Taski.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="backgroundTint">@color/primary_soft</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
    </style>

    <style name="Widget.Taski.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Widget.Taski.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">@dimen/chip_min_height</item>
        <item name="chipMinHeight">@dimen/chip_min_height</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <style name="Widget.Taski.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="errorTextAppearance">@style/TextAppearance.Taski.Caption</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.Taski.Caption</item>
        <item name="errorIconTint">@color/priority_high</item>
    </style>

    <style name="Widget.Taski.TextInput.ExposedDropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="errorTextAppearance">@style/TextAppearance.Taski.Caption</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.Taski.Caption</item>
        <item name="errorIconTint">@color/priority_high</item>
    </style>

    <style name="Widget.Taski.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/background</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="navigationIconTint">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Taski" parent="TextAppearance.Material3.BodyMedium" />

    <style name="TextAppearance.Taski.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Taski.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Taski.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Taski.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Taski.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Taski.Timer" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_timer</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.Taski.Stat" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_stat</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Taski.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/card_background</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Taski.BottomNav.ActiveIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">4dp</item>
        <item name="itemPaddingTop">@dimen/spacing_sm</item>
        <item name="itemPaddingBottom">@dimen/spacing_sm</item>
    </style>

    <style name="Widget.Taski.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_soft</item>
    </style>
</resources>
