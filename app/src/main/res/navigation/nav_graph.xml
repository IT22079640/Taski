<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.taski.ui.splash.SplashFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_onboarding"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.taski.ui.onboarding.OnboardingFragment"
        android:label="@string/onboarding_title"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboarding_to_main"
            app:destination="@id/mainGraph"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <navigation
        android:id="@+id/mainGraph"
        app:startDestination="@id/homeFragment">

        <fragment
            android:id="@+id/homeFragment"
            android:name="com.example.taski.ui.home.HomeFragment"
            android:label="@string/nav_home"
            tools:layout="@layout/fragment_home" />

        <fragment
            android:id="@+id/tasksFragment"
            android:name="com.example.taski.ui.tasks.TasksFragment"
            android:label="@string/nav_tasks"
            tools:layout="@layout/fragment_tasks">
            <action
                android:id="@+id/action_tasks_to_editor"
                app:destination="@id/taskEditorFragment" />
        </fragment>

        <fragment
            android:id="@+id/taskEditorFragment"
            android:name="com.example.taski.ui.tasks.TaskEditorFragment"
            android:label="@string/add_task_title"
            tools:layout="@layout/fragment_task_editor">
            <argument
                android:name="taskId"
                app:argType="long"
                android:defaultValue="0L" />
            <action
                android:id="@+id/action_editor_to_priority_result"
                app:destination="@id/priorityResultFragment"
                app:popUpTo="@id/taskEditorFragment"
                app:popUpToInclusive="true" />
        </fragment>

        <fragment
            android:id="@+id/priorityResultFragment"
            android:name="com.example.taski.ui.priority.PriorityResultFragment"
            android:label="@string/priority_result_title"
            tools:layout="@layout/fragment_priority_result">
            <argument
                android:name="taskId"
                app:argType="long"
                android:defaultValue="0L" />
        </fragment>

        <fragment
            android:id="@+id/planFragment"
            android:name="com.example.taski.ui.plan.PlanFragment"
            android:label="@string/plan_title"
            tools:layout="@layout/fragment_plan">
            <action
                android:id="@+id/action_plan_to_editor"
                app:destination="@id/taskEditorFragment" />
            <action
                android:id="@+id/action_plan_to_focus"
                app:destination="@id/focusFragment" />
        </fragment>

        <fragment
            android:id="@+id/progressFragment"
            android:name="com.example.taski.ui.progress.ProgressFragment"
            android:label="@string/nav_progress"
            tools:layout="@layout/fragment_progress" />

        <fragment
            android:id="@+id/profileFragment"
            android:name="com.example.taski.ui.profile.ProfileFragment"
            android:label="@string/nav_profile"
            tools:layout="@layout/fragment_profile" />

        <fragment
            android:id="@+id/focusFragment"
            android:name="com.example.taski.ui.focus.FocusFragment"
            android:label="@string/app_name"
            tools:layout="@layout/fragment_placeholder">
            <argument
                android:name="taskId"
                app:argType="long"
                android:defaultValue="0L" />
        </fragment>
    </navigation>
</navigation>
