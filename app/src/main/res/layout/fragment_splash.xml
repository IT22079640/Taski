<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="@dimen/screen_padding"
    tools:context=".ui.splash.SplashFragment">

    <ImageView
        android:id="@+id/logo_container"
        android:layout_width="@dimen/logo_splash_size"
        android:layout_height="@dimen/logo_splash_size"
        android:adjustViewBounds="true"
        android:contentDescription="@string/cd_taski_logo"
        android:scaleType="fitCenter"
        android:src="@drawable/taski_logo"
        app:layout_constraintBottom_toTopOf="@id/app_tagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/app_tagline"
        style="@style/TextAppearance.Taski.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/app_tagline"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo_container" />

</androidx.constraintlayout.widget.ConstraintLayout>
