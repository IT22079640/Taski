<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".ui.focus.FocusFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/focus_toolbar"
        style="@style/Widget.Taski.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/focus_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/focus_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/focus_loading"
                android:indeterminate="true"
                app:indicatorColor="@color/primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/focus_missing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding"
            android:visibility="gone">

            <TextView
                style="@style/TextAppearance.Taski.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/focus_missing_title" />

            <TextView
                style="@style/TextAppearance.Taski.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:text="@string/focus_missing_body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/focus_not_found"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding"
            android:visibility="gone">

            <TextView
                style="@style/TextAppearance.Taski.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/focus_not_found_title" />

            <TextView
                style="@style/TextAppearance.Taski.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:text="@string/focus_not_found_body" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/focus_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_xl">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Taski.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_task_title"
                            style="@style/TextAppearance.Taski.ScreenTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:maxLines="3"
                            tools:text="Finish SE4041 lab report" />

                        <TextView
                            android:id="@+id/text_session_status"
                            style="@style/TextAppearance.Taski.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            tools:text="Ready to focus" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Taski.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/timer_progress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:contentDescription="@string/cd_focus_timer"
                                android:indeterminate="false"
                                android:max="1000"
                                app:indicatorColor="@color/primary"
                                app:indicatorSize="@dimen/focus_timer_ring"
                                app:trackColor="@color/primary_soft"
                                app:trackThickness="@dimen/progress_track_thickness"
                                tools:progress="750" />

                            <TextView
                                android:id="@+id/text_countdown"
                                style="@style/TextAppearance.Taski.Timer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:contentDescription="@string/cd_focus_timer"
                                android:gravity="center"
                                tools:text="25:00" />
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_duration"
                    style="@style/Widget.Taski.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Taski.Subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/focus_duration_label" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chip_group_duration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            app:chipSpacingHorizontal="@dimen/spacing_sm"
                            app:chipSpacingVertical="@dimen/spacing_sm"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_duration_25"
                                style="@style/Widget.Taski.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:minHeight="@dimen/chip_min_height"
                                android:text="@string/focus_duration_25" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_duration_50"
                                style="@style/Widget.Taski.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/chip_min_height"
                                android:text="@string/focus_duration_50" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_duration_custom"
                                style="@style/Widget.Taski.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/chip_min_height"
                                android:text="@string/focus_duration_custom" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/container_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start"
                        style="@style/Widget.Taski.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/button_height"
                        android:text="@string/focus_start" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pause"
                            style="@style/Widget.Taski.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:minHeight="@dimen/button_height"
                            android:text="@string/focus_pause" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_stop"
                            style="@style/Widget.Taski.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="@dimen/button_height"
                            android:text="@string/focus_stop" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_complete"
                    style="@style/Widget.Taski.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_complete_title"
                            style="@style/TextAppearance.Taski.Subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/focus_complete_title"
                            android:textColor="@color/accent" />

                        <TextView
                            android:id="@+id/text_complete_body"
                            style="@style/TextAppearance.Taski.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:text="@string/focus_complete_body" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_back_to_plan"
                            style="@style/Widget.Taski.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_lg"
                            android:minHeight="@dimen/button_height"
                            android:text="@string/focus_back_to_plan" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_go_to_tasks"
                            style="@style/Widget.Taski.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:minHeight="@dimen/button_height"
                            android:text="@string/focus_go_to_tasks" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
