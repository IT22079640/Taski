<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/spacing_lg"
    tools:context=".ui.onboarding.OnboardingFragment">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_skip"
        style="@style/Widget.Taski.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/onboarding_skip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/onboarding_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg"
        app:layout_constraintBottom_toTopOf="@id/onboarding_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_skip">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_onboarding_panel">

            <ImageView
                android:id="@+id/image_onboarding_art"
                android:layout_width="@dimen/onboarding_art_size"
                android:layout_height="@dimen/onboarding_art_size"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_onboarding_illustration"
                android:scaleType="fitCenter"
                app:tint="@color/primary"
                tools:src="@drawable/ic_feature_organize" />
        </FrameLayout>

        <TextView
            android:id="@+id/text_onboarding_title"
            style="@style/TextAppearance.Taski.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center_horizontal"
            tools:text="@string/onboarding_page_1_title" />

        <TextView
            android:id="@+id/text_onboarding_body"
            style="@style/TextAppearance.Taski.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center_horizontal"
            tools:text="@string/onboarding_page_1_body" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/onboarding_footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/page_indicators"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot_page_1"
                    android:layout_width="@dimen/page_dot_active_width"
                    android:layout_height="@dimen/page_dot_size"
                    android:background="@drawable/bg_page_dot_active" />

                <View
                    android:id="@+id/dot_page_2"
                    android:layout_width="@dimen/page_dot_size"
                    android:layout_height="@dimen/page_dot_size"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:background="@drawable/bg_page_dot" />

                <View
                    android:id="@+id/dot_page_3"
                    android:layout_width="@dimen/page_dot_size"
                    android:layout_height="@dimen/page_dot_size"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:background="@drawable/bg_page_dot" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next"
                style="@style/Widget.Taski.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:minHeight="@dimen/button_height"
                android:text="@string/onboarding_next" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_get_started"
            style="@style/Widget.Taski.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="@dimen/button_height"
            android:text="@string/onboarding_get_started"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
